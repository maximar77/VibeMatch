# VibeMatch · variables de entorno para AlwaysData
#
# Pega estas variables en AlwaysData → Web → Sites → tu sitio → Environment,
# o cárgalas desde el panel antes de reiniciar el proceso.
# Nunca subas este archivo con valores reales al repositorio.

# --- Obligatorio ---
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VIBEMATCH_SECRET=CAMBIA_ESTE_SECRETO

# --- Sitio público ---
# Dominio exacto del sitio en AlwaysData, sin barra final.
VIBEMATCH_PUBLIC_URL=https://TU_CUENTA.alwaysdata.net
BASE_URL=https://TU_CUENTA.alwaysdata.net
VIBEMATCH_COOKIE_SECURE=1

# Código institucional para crear cuentas de profesor.
VIBEMATCH_TEACHER_CODE=CAMBIA_EL_CODIGO_DEL_COLEGIO

# Nombre que aparece en las tarjetas generadas.
SCHOOL_NAME=Colegio Superior del Maipo

# --- Datos persistentes ---
# Fuera de la carpeta de la aplicación para que sobreviva a los despliegues.
VIBEMATCH_DATA_DIR=/home/TU_CUENTA/vibematch-data
VIBEMATCH_DATA_PERSISTENT=1

# --- APK ---
VIBEMATCH_APP_VERSION=1.2.0
VIBEMATCH_APP_VERSION_CODE=3
VIBEMATCH_APP_APK_URL=https://TU_CUENTA.alwaysdata.net/descargas/VibeMatch-1.2.0.apk
VIBEMATCH_APP_NOTES=Mejoras de estabilidad, NFC y acceso a la comunidad.
