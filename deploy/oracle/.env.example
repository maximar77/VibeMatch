# Copia este archivo a deploy/oracle/.env y completa los valores.
# NUNCA subas deploy/oracle/.env al repositorio.

# Dominio sin https:// (ej: vibematch.cl o vibematch.duckdns.org).
VIBEMATCH_DOMAIN=vibematch.cl

# Correo para Let's Encrypt (avisos de expiración del certificado).
ACME_EMAIL=admin@vibematch.cl

# URL pública exacta, con https://.
VIBEMATCH_PUBLIC_URL=https://vibematch.cl

# Secreto HMAC de la cookie de sesión. Genera uno con:
#   openssl rand -base64 43 | tr -d '\n'
VIBEMATCH_SECRET=

# El sitio se sirve por HTTPS.
VIBEMATCH_COOKIE_SECURE=1

# Código institucional para registrar cuentas de profesor.
VIBEMATCH_TEACHER_CODE=CAMBIAR_CODIGO_2026

# Dominio usado por scripts/generar-tarjetas.mjs al imprimir URLs.
BASE_URL=https://vibematch.cl

# Nombre visible del establecimiento.
SCHOOL_NAME=Colegio Superior del Maipo

# Zona horaria del servidor (afecta fechas de asistencia y logs).
TZ=America/Santiago

# Metadata pública del APK. Si no defines VIBEMATCH_APP_APK_URL, la app usa
# /descargas/VibeMatch-<versión>.apk de VIBEMATCH_PUBLIC_URL.
VIBEMATCH_APP_VERSION=1.1.0
VIBEMATCH_APP_VERSION_CODE=2
# VIBEMATCH_APP_APK_URL=https://vibematch-demo.vercel.app/descargas/VibeMatch-1.1.0.apk
VIBEMATCH_APP_NOTES=Perfil editable, chats, muros y panel docente.
