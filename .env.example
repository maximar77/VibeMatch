# Copia este archivo a .env.local y completa los valores reales.
# Nunca subas .env.local al repositorio.

# Secreto para firmar la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VIBEMATCH_SECRET=

# Activar solo cuando el sitio se sirva por HTTPS.
VIBEMATCH_COOKIE_SECURE=0

# URL pública HTTPS del despliegue (ej: https://vibematch-demo.vercel.app).
# Se usa para marcar cookies Secure y generar enlaces de acceso QR/NFC.
VIBEMATCH_PUBLIC_URL=

# Código institucional para crear cuentas de profesor (entregado por la dirección del establecimiento).
VIBEMATCH_TEACHER_CODE=CODIGO_DIRECCION_2026

# Dominio usado por scripts/generar-tarjetas.mjs al imprimir las URLs.
BASE_URL=http://localhost:3100

# Nombre del establecimiento que aparece en las tarjetas demo.
SCHOOL_NAME=Colegio Superior del Maipo

# Opcional: directorio de datos alternativo. En Oracle/Docker se omite para usar
# ./data (volumen persistente). En una demo sin disco persistente, por ejemplo
# Vercel, se puede usar /tmp/vibematch-data (los datos no sobreviven).
# VIBEMATCH_DATA_DIR=/tmp/vibematch-data

# Metadata pública del APK. Si VIBEMATCH_APP_APK_URL falta, /api/app-version
# usa la última release de GitHub.
VIBEMATCH_APP_VERSION=1.1.0
VIBEMATCH_APP_VERSION_CODE=2
# VIBEMATCH_APP_APK_URL=https://github.com/maximar77/VibeMatch/releases/download/v1.1.0/VibeMatch-1.1.0.apk
# VIBEMATCH_APP_NOTES=Perfil editable, chats, muros y panel docente.
